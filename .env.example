# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Fish Audio — https://fish.audio/ (API keys in your account settings)
FISH_API_KEY=

# Fish Audio voice reference ID (a MALE voice you picked on fish.audio).
# Leave empty to use the model's default male voice preset from config.
FISH_REFERENCE_ID=
